{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "script.js"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Mayonnaise|Apfel Grotezk))/i]",
        "message": "Font not provided by the design system. Available: Mayonnaise, Apfel Grotezk."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--accent",
      "--accent2",
      "--border",
      "--border2",
      "--font-body",
      "--font-display",
      "--green",
      "--hdr",
      "--ink",
      "--ink2",
      "--map-building-fill",
      "--map-building-stroke",
      "--map-park",
      "--map-road-casing",
      "--map-road-fill",
      "--map-water",
      "--muted",
      "--paper",
      "--paper2",
      "--paper3",
      "--radius",
      "--sidebar",
      "--space-1",
      "--space-2",
      "--space-3",
      "--space-4",
      "--space-5",
      "--space-6",
      "--space-7",
      "--space-8",
      "--text-2xl",
      "--text-base",
      "--text-lg",
      "--text-md",
      "--text-sm",
      "--text-xl",
      "--text-xs",
      "--tracking-badge",
      "--tracking-btn",
      "--tracking-label",
      "--tracking-wide",
      "--useit-cream",
      "--useit-mint",
      "--useit-olive",
      "--useit-orange",
      "--useit-red",
      "--useit-teal"
    ],
    "tokenKinds": {
      "--ink": "color",
      "--ink2": "color",
      "--muted": "color",
      "--paper": "color",
      "--paper2": "color",
      "--paper3": "color",
      "--accent": "color",
      "--accent2": "color",
      "--green": "color",
      "--border": "color",
      "--border2": "color",
      "--map-building-fill": "color",
      "--map-building-stroke": "color",
      "--map-road-fill": "color",
      "--map-road-casing": "color",
      "--map-water": "color",
      "--map-park": "color",
      "--useit-orange": "color",
      "--useit-mint": "color",
      "--useit-olive": "color",
      "--useit-teal": "color",
      "--useit-red": "color",
      "--useit-cream": "color",
      "--font-display": "font",
