.DS_Store
# Local Claude Code state stays out, but the shared subagent configs are
# tracked like their .codex/agents/ counterparts (AGENTS.md references them).
.claude/*
!.claude/agents/
test.txt
cache/*.json
cache/*.json.gz
# Personal, machine-specific scripts at repo root (the tracked build lives in tools/).
/deploy.sh
/minify.sh
# Generated build artifacts — regenerate with `bash tools/minify.sh`, never commit.
/script.min.js
/style.min.css
