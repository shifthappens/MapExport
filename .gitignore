.DS_Store
# Local Claude Code state stays out, but the shared subagent configs are
# tracked like their .codex/agents/ counterparts (AGENTS.md references them),
# and so are the project skills.
.claude/*
!.claude/agents/
!.claude/skills/
test.txt
cache/*.json
cache/*.json.gz
# cache/pinned/ IS tracked (the never-expiring validation snapshot), but its
# temporary "stop serving pins" marker is local-only — see tools/pin-cache.sh.
cache/pinned/.disabled
# Where `tools/pin-cache.sh refresh` parks the live entries while it refetches.
cache/.refresh-stash/
# Personal, machine-specific scripts at repo root (the tracked build lives in tools/).
/deploy.sh
/minify.sh
# Generated build artifacts — regenerate with `bash tools/minify.sh`, never commit.
/script.min.js
/style.min.css
